{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "small_model": "openai/gpt-5.4-mini",
  "enabled_providers": [
    "github-copilot",
    "openai",
    "opencode",
    "anthropic",
    "google"
  ],
  "agent": {
    "minion": {
      "model": "openai/gpt-5.4-mini"
    }
  },
  "mcp": {
    "playwright": { "enabled": true }
  }
}
